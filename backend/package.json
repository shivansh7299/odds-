{
  "name": "vitalsync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "bash -c 'prisma migrate dev \"$@\" && prisma generate' --",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "worker": "tsx --conditions=react-server worker/index.ts",
    "worker:dev": "tsx watch --conditions=react-server worker/index.ts",
    "dev:all": "concurrently -k -n web,worker -c blue,magenta \"pnpm dev\" \"pnpm worker:dev\"",
    "simulate:watch": "tsx scripts/simulate-watch.ts",
    "test:e2e": "playwright test",
    "start:all": "concurrently -k -n web,worker \"pnpm start\" \"pnpm worker\"",
    "watch:build": "bash scripts/watch.sh build",
    "watch:sim": "bash scripts/watch.sh sim",
    "watch:install": "bash scripts/watch.sh install",
    "watch:package": "bash scripts/watch.sh package"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/tz": "^1.5.0",
    "@garmin/fitsdk": "^21.217.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.104.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-bluetooth": "^0.0.21",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.29.3"
}
