# Copy to .env and fill in. Never commit .env.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://vitalsync:vitalsync@localhost:5432/vitalsync?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Encryption key for third-party tokens at rest (32 bytes, base64).
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=""
TOKEN_ENC_KEY_VERSION=1
# Set only while rotating keys: the previous key, so old rows still decrypt.
# TOKEN_ENC_KEY_PREVIOUS=""

# Simulated wearable data for local development (shown with a "Simulated" badge).
ENABLE_MOCK_SOURCE=true

# Where uploaded FIT/zip files wait for the worker (must be shared by web + worker).
UPLOAD_DIR=".uploads"

# Extra origins allowed to sign in (comma-separated), e.g. your ngrok domain.
# BETTER_AUTH_TRUSTED_ORIGINS="https://your-domain.ngrok-free.dev"

# Sites allowed to call the read-only /api/v1 API from a browser (comma-separated).
VITALSYNC_CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,https://shivansh7299.github.io"
